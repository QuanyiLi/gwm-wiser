#!/bin/bash -l
#SBATCH --job-name=gwm_wiser_repro
#SBATCH --output=/work/vita/lanfeng/task_logs/%j.log
#SBATCH --partition=h100
#SBATCH --account=vita
#SBATCH --qos=normal
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=64
#SBATCH --gpus-per-node=4
#SBATCH --nodes=3
#SBATCH --time=24:00:00
#SBATCH --mem=200G

# Reproduction/debug run: train.py on WISER merged_train, aligned with
# gwm_wiser/scripts/slurm/submit_gwm.run (the reference gwm_train.py recipe)
# so their curves can be compared:
#   - same data (merged_train via the unchanged AugmentedPaddedDataset,
#     including its unconditional color jitter), same merged_test eval data
#   - same model defaults (dim 4096 / ffn 8192 / head 128 / 5 layers / 32
#     heads / 8 kv), same Muon+AuxAdam lrs, bf16, grad clip 1.0
#   - same scale: 3 nodes x 4 GPUs, per-rank batch 32, num_workers 4
#   - 3-epoch budget in steps: 207,360 samples / (32 x 12) = 540 steps per
#     epoch -> total_steps 1620; save/eval at epoch boundaries (540)
# Known intentional differences: cosine LR anneals per optimizer step
# (T_max=1620) instead of per epoch (T_max=3), and epoch shuffling uses
# this trainer's seeded permutation instead of DistributedSampler.
# Checkpoints from this run are WISER-contaminated: debugging only, never
# phase-one candidates.

set -eo pipefail

# Cluster defaults (kuma). Every path is overridable from the submitting shell.
REPO_ROOT=${REPO_ROOT:-/work/vita/lanfeng/vlas/gwm-wiser}
WISER_DATASET=${WISER_DATASET:-/work/vita/lanfeng/vlas/wise_dataset_0.4.3}
OUTPUT_DIR=${OUTPUT_DIR:-/work/vita/lanfeng/vlas/exp_results/gwm_wiser_repro}
EMBEDDER=${EMBEDDER:-/work/vita/lanfeng/vlas/Qwen3-VL-Embedding-8B}
CONDA_ENV=${CONDA_ENV:-/work/vita/lanfeng/conda_env/gwm-wiser}
CONDA_BASE=${CONDA_BASE:-/home/lfeng/miniconda3}

# The code is imported via PYTHONPATH, but the interpreter still has to be the
# one holding lerobot 0.4.3 / transformers 4.57.6 / torchcodec + ffmpeg.
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"

# Fail before the allocation is spent rather than 12 ranks deep into torchrun.
for d in "${REPO_ROOT}/real_world_gwm" "${WISER_DATASET}/merged_train" \
         "${WISER_DATASET}/merged_test" "${EMBEDDER}"; do
    [ -d "$d" ] || { echo "missing required path: $d" >&2; exit 1; }
done
mkdir -p "${OUTPUT_DIR}"

export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
# Derive the port from the job id: a fixed 29500 collides when two runs land on
# the same node.
export MASTER_PORT=$((29500 + SLURM_JOB_ID % 1000))
export PYTHONPATH=$REPO_ROOT:$PYTHONPATH

# slurm >= 22.05 no longer propagates --cpus-per-task from sbatch to srun, which
# silently starves the dataloader workers.
export SRUN_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}
export OMP_NUM_THREADS=8
export HF_HOME=${HF_HOME:-/work/vita/lanfeng/.cache/}

srun torchrun \
    --nnodes=$SLURM_JOB_NUM_NODES \
    --nproc_per_node=4 \
    --rdzv_id=$SLURM_JOB_ID \
    --rdzv_backend=c10d \
    --rdzv_endpoint=$MASTER_ADDR:$MASTER_PORT \
    -m real_world_gwm.train \
    --dataset_adapter wiser \
    --dataset_roots $WISER_DATASET \
    --output_dir $OUTPUT_DIR \
    --embedder_model_path $EMBEDDER \
    --total_steps 1620 \
    --save_every 540 \
    --batch_size 32 \
    --num_workers 4 \
    --wiser_dev_dataset_root $WISER_DATASET \
    --eval_every 540 \
    --wandb_enable --wandb_project gwm_vrs --wandb_run_name gwm_wiser_repro
