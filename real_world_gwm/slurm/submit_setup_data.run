#!/bin/bash -l
#SBATCH --job-name=gwm_setup_data
#SBATCH --output=/work/vita/lanfeng/task_logs/%j.log
#SBATCH --partition=h100
#SBATCH --account=vita
#SBATCH --qos=normal
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --nodes=1
#SBATCH --time=24:00:00
#SBATCH --mem=64G

# CPU-only data provisioning (setup_data.py) as a slurm job — nothing runs on
# the login node. Downloads the corpora into $DATA_ROOT and clones the URDF
# asset repos (compute nodes have internet on this cluster). No GPU requested;
# override the partition at submit time if a CPU partition exists:
#     sbatch -p <cpu-partition> real_world_gwm/slurm/submit_setup_data.run
#
# Selectors go through SETUP_ARGS (default: the ~600 MB smoke subset):
#     SETUP_ARGS="--source molmobot --configs FrankaPickOmniCamConfig \
#         --split train --shards 0 10 --purge-shard-cache" \
#         sbatch real_world_gwm/slurm/submit_setup_data.run
#
# DROID run-1 (both exterior streams, ALL data files ~190 GB, plus the
# ~220 MB KarlP calibration release; patterns matching nothing are ignored,
# so an oversized range is safe):
#     SETUP_ARGS="--source molmoact2_droid --data-files 0 200" \
#         sbatch real_world_gwm/slurm/submit_setup_data.run
#
# Re-submission is safe: downloads resume from the HF cache and extracted
# shards are skipped via the per-config marker file.

set -eo pipefail

REPO_ROOT=${REPO_ROOT:-/work/vita/lanfeng/vlas/gwm-wiser}
DATA_ROOT=${DATA_ROOT:-${REPO_ROOT}/real_world_gwm/data}
CONDA_ENV=${CONDA_ENV:-/work/vita/lanfeng/conda_env/gwm-wiser}
CONDA_BASE=${CONDA_BASE:-/home/lfeng/miniconda3}
SETUP_ARGS=${SETUP_ARGS:---test-split}

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"

[ -d "${REPO_ROOT}/real_world_gwm" ] || {
    echo "missing required path: ${REPO_ROOT}/real_world_gwm" >&2; exit 1; }

export PYTHONPATH=$REPO_ROOT:$PYTHONPATH
# Never inherit Hugging Face cache locations from the login environment.
# Large Hub blobs and Xet reconstruction data must stay on /work, not $HOME.
export HF_HOME=${GWM_HF_HOME:-/work/vita/lanfeng/.huggingface}
export HF_HUB_CACHE=${HF_HOME}/hub
export HF_XET_CACHE=${HF_HOME}/xet
mkdir -p "$HF_HUB_CACHE" "$HF_XET_CACHE"

srun python -m real_world_gwm.scripts.setup_data \
    --data-root "$DATA_ROOT" \
    $SETUP_ARGS
