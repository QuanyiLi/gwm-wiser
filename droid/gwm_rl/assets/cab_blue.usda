#usda 1.0
(
    defaultPrim = "cab_blue"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cab_blue" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1

    def Scope "Looks"
    {
        def Material "cab_blue_body"
        {
            token outputs:surface.connect = </cab_blue/Looks/cab_blue_body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.19, 0.62)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "cab_blue_front"
        {
            token outputs:surface.connect = </cab_blue/Looks/cab_blue_front/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.29, 0.8)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "knob"
        {
            token outputs:surface.connect = </cab_blue/Looks/knob/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "tray"
        {
            token outputs:surface.connect = </cab_blue/Looks/tray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.44, 0.3)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "knob_phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.2
            float physics:restitution = 0
            float physics:staticFriction = 1.3
        }
    }

    def Cube "wall_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/cab_blue_body>
        float3 xformOp:scale = (0.07, 0.007, 0.128)
        double3 xformOp:translate = (0, -0.093, 0.1731412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/cab_blue_body>
        float3 xformOp:scale = (0.07, 0.007, 0.128)
        double3 xformOp:translate = (0, 0.093, 0.1731412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "top" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/cab_blue_body>
        float3 xformOp:scale = (0.0698, 0.0998, 0.007)
        double3 xformOp:translate = (0, 0, 0.3081412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "back" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/cab_blue_body>
        float3 xformOp:scale = (0.007, 0.0858, 0.1278)
        double3 xformOp:translate = (0.063, 0, 0.1731412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "plinth" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/cab_blue_body>
        float3 xformOp:scale = (0.068, 0.0858, 0.0648)
        double3 xformOp:translate = (0.002, 0, 0.11014120129158238)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "front" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/cab_blue_front>
        float3 xformOp:scale = (0.009, 0.083, 0.06)
        double3 xformOp:translate = (-0.061000000000000006, 0, 0.2381412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "knob" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/knob>
        rel material:binding:physics = </cab_blue/Looks/knob_phys>
        float3 xformOp:scale = (0.015, 0.013, 0.013)
        double3 xformOp:translate = (-0.085, 0, 0.2381412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_bottom" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/tray>
        float3 xformOp:scale = (0.051, 0.083, 0.005)
        double3 xformOp:translate = (-0.0010000000000000078, 0, 0.1831412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_l" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/tray>
        float3 xformOp:scale = (0.051, 0.005, 0.03)
        double3 xformOp:translate = (-0.0010000000000000078, -0.078, 0.2181412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_r" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/tray>
        float3 xformOp:scale = (0.051, 0.005, 0.03)
        double3 xformOp:translate = (-0.0010000000000000078, 0.078, 0.2181412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_back" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_blue/Looks/tray>
        float3 xformOp:scale = (0.005, 0.07300000000000001, 0.03)
        double3 xformOp:translate = (0.04499999999999999, 0, 0.2181412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

