#usda 1.0
(
    defaultPrim = "cab_red"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cab_red" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1

    def Scope "Looks"
    {
        def Material "cab_red_body"
        {
            token outputs:surface.connect = </cab_red/Looks/cab_red_body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.17, 0.14)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "cab_red_front"
        {
            token outputs:surface.connect = </cab_red/Looks/cab_red_front/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.24, 0.2)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "knob"
        {
            token outputs:surface.connect = </cab_red/Looks/knob/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "tray"
        {
            token outputs:surface.connect = </cab_red/Looks/tray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.44, 0.3)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "knob_phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.2
            float physics:restitution = 0
            float physics:staticFriction = 1.3
        }
    }

    def Cube "wall_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/cab_red_body>
        float3 xformOp:scale = (0.09, 0.008, 0.217)
        double3 xformOp:translate = (0, -0.142, 0.26214120129158236)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/cab_red_body>
        float3 xformOp:scale = (0.09, 0.008, 0.217)
        double3 xformOp:translate = (0, 0.142, 0.26214120129158236)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "top" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/cab_red_body>
        float3 xformOp:scale = (0.08979999999999999, 0.1498, 0.008)
        double3 xformOp:translate = (0, 0, 0.4871412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "back" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/cab_red_body>
        float3 xformOp:scale = (0.008, 0.1338, 0.2168)
        double3 xformOp:translate = (0.08199999999999999, 0, 0.26214120129158236)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "plinth" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/cab_red_body>
        float3 xformOp:scale = (0.088, 0.1338, 0.1373)
        double3 xformOp:translate = (0.002, 0, 0.1826412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "front" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/cab_red_front>
        float3 xformOp:scale = (0.009, 0.131, 0.07649999999999998)
        double3 xformOp:translate = (-0.081, 0, 0.3996412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "knob" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/knob>
        rel material:binding:physics = </cab_red/Looks/knob_phys>
        float3 xformOp:scale = (0.015, 0.013, 0.013)
        double3 xformOp:translate = (-0.105, 0, 0.3996412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_bottom" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/tray>
        float3 xformOp:scale = (0.06999999999999999, 0.131, 0.005)
        double3 xformOp:translate = (-0.0020000000000000018, 0, 0.3281412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_l" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/tray>
        float3 xformOp:scale = (0.06999999999999999, 0.005, 0.04)
        double3 xformOp:translate = (-0.0020000000000000018, -0.126, 0.3731412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_r" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/tray>
        float3 xformOp:scale = (0.06999999999999999, 0.005, 0.04)
        double3 xformOp:translate = (-0.0020000000000000018, 0.126, 0.3731412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tray_back" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cab_red/Looks/tray>
        float3 xformOp:scale = (0.005, 0.12100000000000001, 0.04)
        double3 xformOp:translate = (0.06299999999999999, 0, 0.3731412012915824)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

}
