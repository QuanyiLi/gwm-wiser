#!/bin/bash
#SBATCH --job-name=pi0fast
#SBATCH --output=${HOME}/task_logs/%j.log
#SBATCH --partition=h100
#SBATCH --qos=vita
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=64
#SBATCH --gpus-per-node=4
#SBATCH --nodes=1
#SBATCH --time=24:00:00
#SBATCH --mem=200G


accelerate launch \
    --multi_gpu \
    --num_processes=4 \
    --mixed_precision="bf16" \
    /work/vita/lanfeng/vlas/vla/gwm_wiser/scripts/lerobot_train.py \
    --dataset.repo_id="unused" \
    --dataset.root="/work/vita/lanfeng/vlas/vla/wiser_dataset" \
    --policy.type=pi0_fast \
    --output_dir=/work/vita/lanfeng/vlas/exp_results/ \
    --job_name="pi0fast_wiser" \
    --policy.repo_id="unused" \
    --policy.push_to_hub=false \
    --policy.pretrained_path=lerobot/pi0fast-base \
    --policy.compile_model=false \
    --policy.gradient_checkpointing=true \
    --policy.dtype=bfloat16 \
    --policy.device=cuda \
    --policy.n_action_steps=20 \
    --policy.chunk_size=20 \
    --policy.max_action_tokens=256 \
    --policy.empty_cameras=1 \
    --policy.scheduler_warmup_steps=4000 \
    --policy.scheduler_decay_steps=100000 \
    --policy.scheduler_decay_lr=1e-5 \
    --wandb.enable=true \
    --eval_rounds=1 \
    --eval_interval=5 \
    --total_learning_epoches=30 \
    --batch_size=32
