#!/bin/bash -l
#SBATCH --job-name=gwm_setup_data
#SBATCH --output=/work/vita/lanfeng/task_logs/%j.log
#SBATCH --partition=h100
#SBATCH --account=vita
#SBATCH --qos=normal
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --mem=64G

# CPU-bound data provisioning (setup_data.py) as a slurm job — nothing runs
# on the login node. Downloads the corpora into $DATA_ROOT and clones the
# URDF asset repos (compute nodes have internet on this cluster). Kuma
# rejects GPU-less jobs on every partition (QOSMinGRES), so 1 GPU is
# requested; the cheapest slice is a MIG one, via submit-time overrides:
#     sbatch -p mig12gb --cpus-per-task=2 --mem=11G \
#         real_data_train/slurm/submit_setup_data.run
#
# Selectors go through SETUP_ARGS (default: the ~600 MB smoke subset).
# MolmoBot training corpus (ONLY the plain PnP config;
# Pick/Color/NextTo excluded): train shards 0-100 of 1,598, ~217 GB
# downloaded, ~53 GB (~24%, measured) kept on disk after pruning:
#     SETUP_ARGS="--source molmobot --split train --shards 0 100 \
#         --prune-extracted --purge-shard-cache" \
#         sbatch real_data_train/slurm/submit_setup_data.run
#
# DROID (both exterior streams, ALL files ~197 GB, plus the ~220 MB
# KarlP calibration release). Video files outnumber data parquets (518 vs
# 50 in chunk-000), so --video-files must be given explicitly — the default
# mirrors --data-files and would silently skip video files 50+. Patterns
# matching nothing are ignored, so an oversized range is safe:
#     SETUP_ARGS="--source molmoact2_droid --data-files 0 50 --video-files 0 518" \
#         sbatch real_data_train/slurm/submit_setup_data.run
#
# Re-submission is safe: downloads resume from the HF cache and extracted
# shards are skipped via the per-config marker file.

set -eo pipefail

REPO_ROOT=${REPO_ROOT:-/work/vita/lanfeng/vlas/gwm-wiser}
DATA_ROOT=${DATA_ROOT:-${REPO_ROOT}/real_data_train/data}
CONDA_ENV=${CONDA_ENV:-/work/vita/lanfeng/conda_env/gwm-wiser}
CONDA_BASE=${CONDA_BASE:-/home/lfeng/miniconda3}
SETUP_ARGS=${SETUP_ARGS:---test-split}

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"

[ -d "${REPO_ROOT}/real_data_train" ] || {
    echo "missing required path: ${REPO_ROOT}/real_data_train" >&2; exit 1; }

export PYTHONPATH=$REPO_ROOT:$PYTHONPATH
# slurm >= 22.05 no longer propagates --cpus-per-task to srun steps.
export SRUN_CPUS_PER_TASK=$SLURM_CPUS_PER_TASK
# Never inherit Hugging Face cache locations from the login environment.
# Large Hub blobs and Xet reconstruction data must stay on /work, not $HOME.
export HF_HOME=${GWM_HF_HOME:-/work/vita/lanfeng/.huggingface}
export HF_HUB_CACHE=${HF_HOME}/hub
export HF_XET_CACHE=${HF_HOME}/xet
mkdir -p "$HF_HUB_CACHE" "$HF_XET_CACHE"

srun python -m real_data_train.scripts.setup_data \
    --data-root "$DATA_ROOT" \
    $SETUP_ARGS
