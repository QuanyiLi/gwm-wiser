#!/bin/bash -l
#SBATCH --job-name=gwm_molmo
#SBATCH --output=/work/vita/lanfeng/task_logs/%j.log
#SBATCH --partition=h100
#SBATCH --account=vita
#SBATCH --qos=normal
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=64
#SBATCH --gpus-per-node=4
#SBATCH --nodes=3
# QoS normal allows 3-00:00:00; 37.5k steps at the measured 0.30 steps/s
# need ~35 h, so the default fits a full run in ONE segment.
#SBATCH --time=40:00:00
# --mem deliberately omitted -> the per-node maximum (64 cores x 5900 MB
# ~ 369 G); a 200 G cap gets OOM-killed (MaxRSS reaches it exactly).

# GWM training on the Molmo corpora.
# Reference recipe: 3 nodes x 4 H100. The exact-grid policy (every sample lands
# on the 1620-token operating grid) restores uniform batching, so the
# per-rank batch matches the original GWM recipe.
#
# Prerequisites on kuma (each its own slurm job; nothing on the login node):
#   sbatch real_data_train/slurm/submit_setup_data.run      # data + URDF assets
#   sbatch real_data_train/slurm/submit_render_actions.run  # rendered tree
# The audit runs automatically at startup and fail-fasts on off-grid clips;
# pre-generate it once (python -m real_data_train.audit, ~20 min CPU) and pass
# MANIFEST= so the 12 ranks skip it.
#
# Measured on a 3x4 H100 run: 0.30 steps/s steady (the
# 2-rank debug smoke gives 0.59 — inter-node allreduce/IO halves it),
# ~80 GB/GPU and ~82 GB/node RSS, 3.6 GB per checkpoint step dir, ~26 ms
# per Qwen embed forward. 37.5k steps ~ 35 h -> single 40 h segment; for
# longer recipes chain segments with RESUME=<out>/step_*/train_state.pt.
# Held-out eval costs ~7 s per eval batch per loader (dev + 2 sweeps), so
# --eval_batches 64 is ~14 min per eval point; trim via EXTRA_ARGS if needed.

set -eo pipefail

# Cluster defaults (kuma). Every path is overridable from the submitting shell.
REPO_ROOT=${REPO_ROOT:-/work/vita/lanfeng/vlas/gwm-wiser}
DATA_ROOT=${DATA_ROOT:-${REPO_ROOT}/real_data_train/data}
OUTPUT_DIR=${OUTPUT_DIR:-/work/vita/lanfeng/vlas/exp_results/gwm_molmo}
EMBEDDER=${EMBEDDER:-/work/vita/lanfeng/vlas/Qwen3-VL-Embedding-8B}
CONDA_ENV=${CONDA_ENV:-/work/vita/lanfeng/conda_env/gwm-wiser}
CONDA_BASE=${CONDA_BASE:-/home/lfeng/miniconda3}
TOTAL_STEPS=${TOTAL_STEPS:-90000}
BATCH_SIZE=${BATCH_SIZE:-32}
# Corpus selection (default: real + sim, natural mixture).
# Single-source runs: SOURCES=molmobot or SOURCES=molmoact2_droid.
SOURCES=${SOURCES:-molmobot molmoact2_droid}
# Pre-generated audit manifest (python -m real_data_train.audit) — skips the
# per-rank startup audit; strongly recommended for multi-node runs.
MANIFEST=${MANIFEST:-}
# Clip discovery cache (see --discovery_cache): turns the ~21 min per-rank
# meta.json walk into a seconds-long sequential read. ON by default — the
# tree signature auto-invalidates it when clips are added/removed/renamed
# (an in-place re-render into identical names needs a manual delete).
# DISCOVERY_CACHE="" disables.
DISCOVERY_CACHE=${DISCOVERY_CACHE-${DATA_ROOT}/rendered_discovery_cache.json}
# Resume from a step_*/train_state.pt of a previous run (walltime chaining).
RESUME=${RESUME:-}
# Appended last; argparse last-wins, so flags here override the ones below
# (e.g. EXTRA_ARGS="--eval_batches 8 --save_every 5000").
EXTRA_ARGS=${EXTRA_ARGS:-}

# The code is imported via PYTHONPATH, but the interpreter still has to be the
# one holding lerobot 0.4.3 / transformers 4.57.6 / torchcodec + ffmpeg.
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"

# Fail before the allocation is spent rather than 12 ranks deep into torchrun.
for d in "${REPO_ROOT}/real_data_train" "${DATA_ROOT}/rendered" "${EMBEDDER}"; do
    [ -d "$d" ] || { echo "missing required path: $d" >&2; exit 1; }
done
mkdir -p "${OUTPUT_DIR}"

export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
# Derive the port from the job id: a fixed 29500 collides when two runs land on
# the same node.
export MASTER_PORT=$((29500 + SLURM_JOB_ID % 1000))
export PYTHONPATH=$REPO_ROOT:$PYTHONPATH

# slurm >= 22.05 no longer propagates --cpus-per-task from sbatch to srun, which
# silently starves the dataloader workers.
export SRUN_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}
export OMP_NUM_THREADS=8
# Repo-scoped wandb identity: if the gitignored key file exists, it wins over
# the machine-wide ~/.netrc login (WANDB_API_KEY has precedence in wandb).
# Create it as:  echo 'export WANDB_API_KEY=<key>' > <repo>/.wandb_api_key.env
#                chmod 600 <repo>/.wandb_api_key.env
if [ -f "${REPO_ROOT}/.wandb_api_key.env" ]; then
    source "${REPO_ROOT}/.wandb_api_key.env"
fi

# Never inherit Hugging Face cache locations from the login environment.
export HF_HOME=${GWM_HF_HOME:-/work/vita/lanfeng/.huggingface}
export HF_HUB_CACHE=${HF_HOME}/hub
export HF_XET_CACHE=${HF_HOME}/xet
mkdir -p "$HF_HUB_CACHE" "$HF_XET_CACHE"

srun torchrun \
    --nnodes=$SLURM_JOB_NUM_NODES \
    --nproc_per_node=4 \
    --rdzv_id=$SLURM_JOB_ID \
    --rdzv_backend=c10d \
    --rdzv_endpoint=$MASTER_ADDR:$MASTER_PORT \
    -m real_data_train.train \
    --data_root $DATA_ROOT \
    --sources $SOURCES \
    --output_dir $OUTPUT_DIR \
    --embedder_model_path $EMBEDDER \
    --total_steps $TOTAL_STEPS \
    --save_every 2000 \
    --batch_size $BATCH_SIZE \
    --num_workers 8 \
    --eval_every 2000 --eval_batches 64 \
    --wandb_enable --wandb_project gwm_molmo \
    ${MANIFEST:+--manifest $MANIFEST} \
    ${DISCOVERY_CACHE:+--discovery_cache $DISCOVERY_CACHE} \
    ${RESUME:+--resume $RESUME} \
    $EXTRA_ARGS
